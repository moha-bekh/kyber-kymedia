From 84ce42e280b42e470f0ed021398b43620b92ea3a Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Romain=20Roff=C3=A9?= <rofferom@gmail.com>
Date: Sun, 1 Aug 2021 18:27:52 +0200
Subject: [PATCH] configure: Disable FORTIFY_SOURCE

Regenerated against opus 1.6.1's configure (the FORTIFY_SOURCE block moved
since 1.3.1). Drops the autoconf logic that appends -D_FORTIFY_SOURCE=2 to
CFLAGS.
---
--- a/configure
+++ b/configure
@@ -16891,44 +16891,6 @@ rm -f core conftest.err conftest.$ac_objext conftest.beam \
 
 fi
 
-if test x$ac_cv_c_compiler_gnu = xyes
-then :
-
-    { printf "%s\n" "$as_me:${as_lineno-$LINENO}: checking whether to add -D_FORTIFY_SOURCE=2 to CFLAGS" >&5
-printf %s "checking whether to add -D_FORTIFY_SOURCE=2 to CFLAGS... " >&6; }
-    cat confdefs.h - <<_ACEOF >conftest.$ac_ext
-/* end confdefs.h.  */
-
-
-                int main() {
-                #ifndef _FORTIFY_SOURCE
-                    return 0;
-                #else
-                    this_is_an_error;
-                #endif
-                }
-
-
-_ACEOF
-if ac_fn_c_try_link "$LINENO"
-then :
-
-            { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: yes" >&5
-printf "%s\n" "yes" >&6; }
-            CFLAGS="$CFLAGS -D_FORTIFY_SOURCE=2"
-
-else $as_nop
-
-            { printf "%s\n" "$as_me:${as_lineno-$LINENO}: result: no" >&5
-printf "%s\n" "no" >&6; }
-
-fi
-rm -f core conftest.err conftest.$ac_objext conftest.beam \
-    conftest$ac_exeext conftest.$ac_ext
-
-
-fi
-
 CFLAGS="$CFLAGS -W"
 
 warn_CFLAGS="-Wall -Wextra -Wcast-align -Wnested-externs -Wshadow -Wstrict-prototypes"
-- 
2.43.0
