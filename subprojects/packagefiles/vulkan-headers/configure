# cmake configure wrapper for meson unstable-external_project
# Runs from the cmake build directory (workdir = external_project build_dir)
set -e

SRC_DIR="$(cd "$(dirname "$0")" && pwd)"
PREFIX=/usr/local
LIBDIR=lib
INCLUDEDIR=include
VERSION=1.4.313

for arg; do
    case "$arg" in
        --prefix=*)     PREFIX="${arg#*=}" ;;
        --libdir=*)     LIBDIR="${arg#*=}" ;;
        --includedir=*) INCLUDEDIR="${arg#*=}" ;;
        --version=*)    VERSION="${arg#*=}" ;;
    esac
done

# cmake expects relative paths (relative to prefix); strip prefix if present
LIBDIR="${LIBDIR#"$PREFIX/"}"
INCLUDEDIR="${INCLUDEDIR#"$PREFIX/"}"

# shellcheck disable=SC2086
cmake "$SRC_DIR" \
    -G "Unix Makefiles" \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" \
    -DCMAKE_INSTALL_LIBDIR="$LIBDIR" \
    -DCMAKE_INSTALL_INCLUDEDIR="$INCLUDEDIR" \
    -DCMAKE_BUILD_TYPE=Release \
    ${CROSS_CMAKE_ARGS:-}

cmake --build . --parallel "$(nproc)"
cmake --install .

PC_DIR="$PREFIX/$LIBDIR/pkgconfig"
mkdir -p "$PC_DIR"
cat > "$PC_DIR/vulkan.pc" <<EOF
prefix=$PREFIX
includedir=\${prefix}/$INCLUDEDIR

Name: Vulkan-Headers
Description: Vulkan Header files and API registry (Project Kyber, headers only)
Version: $VERSION
Cflags: -I\${includedir}
EOF
