# cmake configure wrapper for meson unstable-external_project
# Runs from the cmake build directory (workdir = external_project build_dir)
# Uses cmake instead of autotools to avoid issues with zlib's custom configure.
set -e

# $0 is an absolute path when invoked by meson; no fork needed
SRC_DIR="${0%/*}"
PREFIX=/usr/local
LIBDIR=lib
INCLUDEDIR=include

for arg; do
    case "$arg" in
        --prefix=*)     PREFIX="${arg#*=}" ;;
        --libdir=*)     LIBDIR="${arg#*=}" ;;
        --includedir=*) INCLUDEDIR="${arg#*=}" ;;
        # Ignore --static, --bindir, and other args cmake does not use
    esac
done

# cmake expects a relative libdir (relative to prefix); strip prefix if present
LIBDIR="${LIBDIR#"$PREFIX/"}"
INCLUDEDIR="${INCLUDEDIR#"$PREFIX/"}"

# zlib uses its own install dir variables, not cmake's standard GNUInstallDirs ones
# shellcheck disable=SC2086
cmake "$SRC_DIR" \
    -G "Unix Makefiles" \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" \
    -DINSTALL_LIB_DIR="$PREFIX/$LIBDIR" \
    -DINSTALL_INC_DIR="$PREFIX/$INCLUDEDIR" \
    -DINSTALL_PKGCONFIG_DIR="$PREFIX/$LIBDIR/pkgconfig" \
    -DCMAKE_BUILD_TYPE=Release \
    -DZLIB_BUILD_SHARED=OFF \
    ${CROSS_CMAKE_ARGS:-}

cmake --build .
cmake --install .

# On Windows, zlib 1.3.2's CMake sets zlib_static_suffix="s", producing libzs.a
# (older zlib cmake used libzlibstatic.a).  Create the libz.a alias if needed.
for _candidate in libzs.a libzlibstatic.a; do
    if [ -f "$PREFIX/$LIBDIR/$_candidate" ] && [ ! -f "$PREFIX/$LIBDIR/libz.a" ]; then
        cp "$PREFIX/$LIBDIR/$_candidate" "$PREFIX/$LIBDIR/libz.a"
        break
    fi
done
