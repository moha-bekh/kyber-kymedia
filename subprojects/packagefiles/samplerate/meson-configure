# Wrapper for meson unstable-external_project.
# Runs from the build directory; invokes the real autotools configure, then
# builds and installs immediately so that pkg-config files are available
# during the meson setup phase (e.g. for ffmpeg's configure).
set -e

SRC_DIR="${0%/*}"

"$SRC_DIR/configure" "$@"
make -j"$(nproc 2>/dev/null || sysctl -n hw.logicalcpu)"
make install
