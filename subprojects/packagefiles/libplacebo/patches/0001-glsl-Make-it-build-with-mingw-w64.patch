From 6f762f11b0cd47666608668c5a8846b45be9eb53 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Romain=20Roff=C3=A9?= <romain@kyber.media>
Date: Thu, 5 Dec 2024 11:11:51 +0100
Subject: [PATCH 1/4] glsl: Make it build with mingw-w64

---
 src/glsl/meson.build | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/src/glsl/meson.build b/src/glsl/meson.build
index b1f4c8d0..3f1e498e 100644
--- a/src/glsl/meson.build
+++ b/src/glsl/meson.build
@@ -28,9 +28,9 @@ if glslang_req.auto() and shaderc.found()
   message('Skipping `glslang` because `shaderc` is available')
 
 elif not glslang_req.disabled()
-
+  glslang_lib = dependency('glslang', required: true)
   glslang_deps = [
-    cxx.find_library('glslang-default-resource-limits', required: false)
+    glslang_lib
   ]
 
   # meson doesn't respect generator expressions in INTERFACE_LINK_LIBRARIES
@@ -44,7 +44,7 @@ elif not glslang_req.disabled()
     static   = arg[0]
     required = arg[1]
 
-    spirv = cxx.find_library('SPIRV', required: required, static: static)
+    spirv = dependency('spirv', required: required, static: static)
 
     if not spirv.found()
       continue
@@ -67,13 +67,18 @@ elif not glslang_req.disabled()
         cxx.find_library('SPIRV-Tools',        required: false, static: true),
         cxx.find_library('SPIRV-Tools-opt',    required: false, static: true),
       ]
+    else
+      glslang_deps += [
+        # SPIRV-Tools are required only if optimizer is enabled in glslang build
+        dependency('SPIRV-Tools',        required: false, static: false),
+      ]
     endif
 
     found_lib = true
     break
   endforeach
 
-  if found_lib and cc.has_header('glslang/build_info.h')
+  if found_lib and glslang_lib.found()
     glslang = declare_dependency(dependencies: glslang_deps)
   endif
 
-- 
