# make wrapper for meson unstable-external_project
# Runs from the build directory (workdir = external_project build_dir)
set -e

SRC_DIR="${0%/*}"
PREFIX=/usr/local
LIBDIR=lib

for arg; do
    case "$arg" in
        --prefix=*) PREFIX="${arg#*=}" ;;
        --libdir=*)  LIBDIR="${arg#*=}" ;;
    esac
done

# nv-codec-headers Makefile uses $(PREFIX)/$(LIBDIR)/pkgconfig, so LIBDIR must be relative
LIBDIR="${LIBDIR#"$PREFIX/"}"

make -C "$SRC_DIR" PREFIX="$PREFIX" LIBDIR="$LIBDIR"
make -C "$SRC_DIR" PREFIX="$PREFIX" LIBDIR="$LIBDIR" install
