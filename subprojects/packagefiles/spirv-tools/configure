# cmake configure wrapper for meson unstable-external_project
# Runs from the cmake build directory (workdir = external_project build_dir)
set -e

SRC_DIR="$(cd "$(dirname "$0")" && pwd)"
PREFIX=/usr/local
LIBDIR=lib
INCLUDEDIR=include

for arg; do
    case "$arg" in
        --prefix=*)     PREFIX="${arg#*=}" ;;
        --libdir=*)     LIBDIR="${arg#*=}" ;;
        --includedir=*) INCLUDEDIR="${arg#*=}" ;;
    esac
done

# cmake expects relative paths (relative to prefix); strip prefix if present
LIBDIR="${LIBDIR#"$PREFIX/"}"
INCLUDEDIR="${INCLUDEDIR#"$PREFIX/"}"

# shellcheck disable=SC2086
cmake "$SRC_DIR" \
    -G "Unix Makefiles" \
    -DCMAKE_INSTALL_PREFIX="$PREFIX" \
    -DCMAKE_INSTALL_LIBDIR="$LIBDIR" \
    -DCMAKE_INSTALL_INCLUDEDIR="$INCLUDEDIR" \
    -DCMAKE_BUILD_TYPE=Release \
    -DSPIRV_TOOLS_BUILD_STATIC=OFF \
    "-DSPIRV-Headers_SOURCE_DIR=$SPIRV_HEADERS_SRC" \
    -DSPIRV_SKIP_EXECUTABLES=ON \
    -DSPIRV_SKIP_TESTS=ON \
    -DCMAKE_CXX_FLAGS="-Wno-error=array-bounds" \
    ${CROSS_CMAKE_ARGS:-}

# Build and install here so downstream subprojects (e.g. glslang) can find
# the installed pkg-config files during their own configure step.
cmake --build . --parallel "$(nproc)"
cmake --install .
