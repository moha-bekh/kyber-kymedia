[wrap-file]
directory = FFmpeg-n8.1
source_url = https://github.com/FFmpeg/FFmpeg/archive/refs/tags/n8.1.tar.gz
source_filename = FFmpeg-n8.1.tar.gz
source_hash = dd308201bb1239a1b73185f80c6b4121f4efdfa424a009ce544fd00bf736bb2e
patch_directory = ffmpeg
diff_files =
  ffmpeg/patches/0001-nvenc-Patch-SPS-when-zerolatency-is-enabled.patch,
  ffmpeg/patches/0002-libavutil-d3d11va-Avoid-to-query-ID3D11VideoDevice-a.patch,
  ffmpeg/patches/0003-libavutil-Implement-monotonic-av_gettime_relative-on.patch,
  ffmpeg/patches/0004-configure-Use-pkg_config_flags-in-test_pkg_config-fu.patch,
  ffmpeg/patches/0005-Revert-avutil-hwcontext_d3d11va-remove-D3D11_BIND_RE.patch,
  ffmpeg/patches/0006-avcodec-dxva2_hevc-add-support-for-parsing-HEVC-Rang.patch,
  ffmpeg/patches/0007-avcodec-mpeg12dec-don-t-call-hw-end_frame-when-start.patch,
  ffmpeg/patches/0008-fix-mf_utils-compilation-with-mingw64.patch,
  ffmpeg/patches/0009-avcodec-hevcdec-allow-HEVC-444-8-10-12-bits-decoding.patch,
  ffmpeg/patches/0010-avcodec-mpeg12dec-don-t-end-a-slice-without-first_sl.patch,
  ffmpeg/patches/0011-avcodec-hevcdec-allow-HEVC-422-10-12-bits-decoding-w.patch,
  ffmpeg/patches/0012-avcodec-videotoolboxenc-disable-calls-on-unsupported.patch,
  ffmpeg/patches/0013-avcodec-fix-compilation-visionos.patch,
  ffmpeg/patches/0014-dxva_vc1_crash.patch,
  ffmpeg/patches/0015-h264_early_SAR.patch,
  ffmpeg/patches/0016-avcodec-videotoolboxenc-switch-to-receive_packet-API.patch,
  ffmpeg/patches/0017-avcodec-videotoolboxenc-add-signpost-timing.patch,
  ffmpeg/patches/0018-avcodec-videotoolboxenc-set-expected-framerate.patch,
  ffmpeg/patches/0019-avcodec-videotoolboxenc-make-VT-blocking.patch

[provide]
dependency_names = ffmpeg, libavcodec, libavformat, libavutil, libswresample, libswscale, libavfilter, libavdevice
