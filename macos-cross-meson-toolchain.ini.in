# Meson cross-file template for macOS cross-architecture builds
# (e.g. building x86_64 on an arm64 runner or vice-versa).
#
# Placeholders substituted by build-macos.sh via sed:
#   @CPU_FAMILY@  — Meson cpu_family value: 'x86_64' or 'aarch64'
#   @HOST_ARCH@   — clang -arch value: 'x86_64' or 'arm64'

[binaries]
c = 'clang'
cpp = 'clang++'
objc = 'clang'
objcpp = 'clang++'
ar = 'ar'
strip = 'strip'
pkg-config = 'pkg-config'

[properties]
# On Apple Silicon, Rosetta transparently runs x86_64 binaries, so configure
# test programs compiled for x86_64 can execute on the arm64 build machine.
needs_exe_wrapper = false

[built-in options]
c_args = ['-arch', '@HOST_ARCH@']
cpp_args = ['-arch', '@HOST_ARCH@']
objc_args = ['-arch', '@HOST_ARCH@']
objcpp_args = ['-arch', '@HOST_ARCH@']
c_link_args = ['-arch', '@HOST_ARCH@']
cpp_link_args = ['-arch', '@HOST_ARCH@']
objc_link_args = ['-arch', '@HOST_ARCH@']
objcpp_link_args = ['-arch', '@HOST_ARCH@']

[host_machine]
system = 'darwin'
cpu_family = '@CPU_FAMILY@'
cpu = '@HOST_ARCH@'
endian = 'little'
