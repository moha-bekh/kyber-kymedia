From 22e42b94e3cdc5ee8d96a027ab7ff6d31ccb571f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Romain=20Roff=C3=A9?= <rofferom@gmail.com>
Date: Wed, 16 Mar 2022 19:50:18 +0100
Subject: [PATCH] Add CMakeLists.txt

---
 CMakeLists.txt | 64 ++++++++++++++++++++++++++++++++++++++++++++++++++
 lua.pc.in      | 10 ++++++++
 2 files changed, 79 insertions(+)
 create mode 100644 CMakeLists.txt
 create mode 100644 lua.pc.in

diff --git a/CMakeLists.txt b/CMakeLists.txt
new file mode 100644
index 0000000..64b4f63
--- /dev/null
+++ b/CMakeLists.txt
@@ -0,0 +1,64 @@
+cmake_minimum_required(VERSION 3.0)
+project(lua)
+
+include(GNUInstallDirs)
+
+add_library(lua SHARED
+    src/lapi.c
+    src/lauxlib.c
+    src/lbaselib.c
+    src/lcode.c
+    src/lcorolib.c
+    src/lctype.c
+    src/ldblib.c
+    src/ldebug.c
+    src/ldo.c
+    src/ldump.c
+    src/lfunc.c
+    src/lgc.c
+    src/linit.c
+    src/liolib.c
+    src/llex.c
+    src/lmathlib.c
+    src/lmem.c
+    src/loadlib.c
+    src/lobject.c
+    src/lopcodes.c
+    src/loslib.c
+    src/lparser.c
+    src/lstate.c
+    src/lstring.c
+    src/lstrlib.c
+    src/ltable.c
+    src/ltablib.c
+    src/ltm.c
+    src/lundump.c
+    src/lutf8lib.c
+    src/lvm.c
+    src/lzio.c
+)
+
+target_include_directories(lua
+    PUBLIC
+        ${CMAKE_CURRENT_SOURCE_DIR}/include
+    PRIVATE
+        ${CMAKE_CURRENT_SOURCE_DIR}/src
+)
+
+configure_file(lua.pc.in lua.pc @ONLY)
+
+install(
+    DIRECTORY "${CMAKE_SOURCE_DIR}/src/"
+    DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}"
+    FILES_MATCHING PATTERN "*.h"
+)
+
+install(TARGETS lua
+    ARCHIVE DESTINATION "${CMAKE_INSTALL_LIBDIR}"
+    RUNTIME DESTINATION "${CMAKE_INSTALL_BINDIR}"
+    PUBLIC_HEADER DESTINATION "${CMAKE_INSTALL_INCLUDEDIR}"
+)
+
+install(FILES ${CMAKE_BINARY_DIR}/lua.pc
+    DESTINATION "${CMAKE_INSTALL_LIBDIR}/pkgconfig"
+)
diff --git a/lua.pc.in b/lua.pc.in
new file mode 100644
index 0000000..a112e3e
--- /dev/null
+++ b/lua.pc.in
@@ -0,0 +1,10 @@
+prefix="@CMAKE_INSTALL_PREFIX@"
+exec_prefix="${prefix}"
+libdir="${prefix}/lib"
+includedir="${prefix}/include"
+
+Name: lua
+Description: Lua
+Version: 5.4.4
+Libs: -L${libdir} -llua
+Cflags: -I${includedir}
-- 
2.30.2

