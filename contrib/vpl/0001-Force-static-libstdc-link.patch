From: =?UTF-8?q?Romain=20Roff=C3=A9?= <romain@kyber.media>
Date: Tue, 27 Feb 2024 19:31:55 +0100
Subject: [PATCH 1/2] Force static libstdc++ link

---
 libvpl/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libvpl/CMakeLists.txt b/libvpl/CMakeLists.txt
index b02ec05..8c2ed23 100644
--- a/libvpl/CMakeLists.txt
+++ b/libvpl/CMakeLists.txt
@@ -180,7 +180,7 @@ if(BUILD_DEV)
     set(MINGW_LIBS "-lole32 -lgdi32 -luuid")
   endif()
   if(NOT MSVC)
-    set(CXX_LIB "-lstdc++")
+    set(CXX_LIB "-Wl,-Bstatic -lstdc++ -Wl,-Bdynamic")
   endif()
   set(VPL_PKGCONFIG_DEPENDENT_LIBS
       "${DL_LIBS} ${CMAKE_THREAD_LIBS_INIT} ${MINGW_LIBS} ${CXX_LIB}")
