From: =?UTF-8?q?Romain=20Roff=C3=A9?= <rofferom@gmail.com>
Date: Fri, 6 Jan 2023 18:34:15 +0100
Subject: [PATCH 1/2] Force static libstdc++ link

---
 dispatcher/CMakeLists.txt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/dispatcher/CMakeLists.txt b/dispatcher/CMakeLists.txt
index 05cf168..2524f08 100644
--- a/dispatcher/CMakeLists.txt
+++ b/dispatcher/CMakeLists.txt
@@ -179,7 +179,7 @@ if(BUILD_DEV)
     set(MINGW_LIBS "-lole32 -lgdi32 -luuid")
   endif()
   if(NOT MSVC)
-    set(CXX_LIB "-lstdc++")
+    set(CXX_LIB "-Wl,-Bstatic -lstdc++ -Wl,-Bdynamic")
   endif()
   set(VPL_PKGCONFIG_DEPENDENT_LIBS
       "${DL_LIBS} ${CMAKE_THREAD_LIBS_INIT} ${MINGW_LIBS} ${CXX_LIB}")
