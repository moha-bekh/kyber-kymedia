From ce100b36efe6ae85370b9afbdb2523d595f55d21 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Romain=20Roff=C3=A9?= <romain@kyber.media>
Date: Tue, 27 Feb 2024 19:32:54 +0100
Subject: [PATCH 2/2] cmake: Fix .pc generated file

---
 libvpl/CMakeLists.txt      | 12 +++---------
 libvpl/pkgconfig/vpl.pc.in |  6 +++---
 2 files changed, 6 insertions(+), 12 deletions(-)

diff --git a/libvpl/CMakeLists.txt b/libvpl/CMakeLists.txt
index 8c2ed23..19d7318 100644
--- a/libvpl/CMakeLists.txt
+++ b/libvpl/CMakeLists.txt
@@ -161,15 +161,9 @@ if(BUILD_DEV)
     DESTINATION "${CMAKE_INSTALL_LIBDIR}/cmake/vpl"
     COMPONENT ${VPL_COMPONENT_DEV})
 
-  file(RELATIVE_PATH pc_rel_prefix ${CMAKE_INSTALL_FULL_LIBDIR}/pkgconfig
-       ${CMAKE_INSTALL_PREFIX})
-  file(RELATIVE_PATH pc_rel_libdir ${CMAKE_INSTALL_FULL_LIBDIR}/pkgconfig
-       ${CMAKE_INSTALL_FULL_LIBDIR})
-  file(RELATIVE_PATH pc_rel_incdir ${CMAKE_INSTALL_FULL_LIBDIR}/pkgconfig
-       ${CMAKE_INSTALL_FULL_INCLUDEDIR})
-  set(pc_rel_prefix "$\{pcfiledir}/${pc_rel_prefix}")
-  set(pc_rel_libdir "$\{pcfiledir}/${pc_rel_libdir}")
-  set(pc_rel_incdir "$\{pcfiledir}/${pc_rel_incdir}")
+  set(pc_prefix "${CMAKE_INSTALL_PREFIX}")
+  set(pc_libdir "${CMAKE_INSTALL_LIBDIR}")
+  set(pc_incdir "${CMAKE_INSTALL_INCLUDEDIR}")
 
   if(CMAKE_DL_LIBS)
     set(DL_LIBS "-l${CMAKE_DL_LIBS}")
diff --git a/libvpl/pkgconfig/vpl.pc.in b/libvpl/pkgconfig/vpl.pc.in
index 4581141..936d5f7 100644
--- a/libvpl/pkgconfig/vpl.pc.in
+++ b/libvpl/pkgconfig/vpl.pc.in
@@ -1,6 +1,6 @@
-prefix=@pc_rel_prefix@
-libdir=@pc_rel_libdir@
-includedir=@pc_rel_incdir@
+prefix=@pc_prefix@
+libdir=${prefix}/@pc_libdir@
+includedir=${prefix}/@pc_incdir@
 
 Name: Intel® Video Processing Library
 Description: Accelerated video decode, encode, and frame processing capabilities on Intel® GPUs
-- 
2.39.2

