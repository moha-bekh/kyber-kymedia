From 925fabed6dc1396c4c74bf9b24cff2a61743011c Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Romain=20Roff=C3=A9?= <romain@kyber.media>
Date: Mon, 16 Dec 2024 12:59:49 +0100
Subject: [PATCH 3/4] libavutil: Implement monotonic av_gettime_relative() on
 Win32

---
 libavutil/time.c | 35 +++++++++++++++++++++++++++++++++++
 1 file changed, 35 insertions(+)

diff --git a/libavutil/time.c b/libavutil/time.c
index 740afc4785..7b5966c0c7 100644
--- a/libavutil/time.c
+++ b/libavutil/time.c
@@ -34,7 +34,9 @@
 #endif
 
 #include "time.h"
+#include "avassert.h"
 #include "error.h"
+#include "thread.h"
 
 int64_t av_gettime(void)
 {
@@ -53,6 +55,35 @@ int64_t av_gettime(void)
 #endif
 }
 
+#ifdef _WIN32
+static LARGE_INTEGER win32_clock_freq;
+
+static av_cold void av_gettime_relative_win32_init(void)
+{
+    BOOL ret = QueryPerformanceFrequency(&win32_clock_freq);
+    av_assert1(ret != 0);
+}
+
+static int64_t av_gettime_relative_win32(void)
+{
+    LARGE_INTEGER counter;
+
+    static AVOnce init_static_once = AV_ONCE_INIT;
+    ff_thread_once(&init_static_once, av_gettime_relative_win32_init);
+
+    BOOL ret = QueryPerformanceCounter(&counter);
+    av_assert2(ret != 0);
+
+    // microseconds
+    // Based on
+    // https://learn.microsoft.com/en-us/windows/win32/sysinfo/acquiring-high-resolution-time-stamps#using-qpc-in-native-code
+    int64_t micros = counter.QuadPart * 1000000;
+    micros /= win32_clock_freq.QuadPart;
+
+    return micros;
+}
+#endif
+
 int64_t av_gettime_relative(void)
 {
 #if HAVE_CLOCK_GETTIME && defined(CLOCK_MONOTONIC)
@@ -64,6 +95,8 @@ int64_t av_gettime_relative(void)
         clock_gettime(CLOCK_MONOTONIC, &ts);
         return (int64_t)ts.tv_sec * 1000000 + ts.tv_nsec / 1000;
     }
+#elif _WIN32
+    return av_gettime_relative_win32();
 #endif
     return av_gettime() + 42 * 60 * 60 * INT64_C(1000000);
 }
@@ -76,6 +109,8 @@ int av_gettime_relative_is_monotonic(void)
         return 0;
 #endif
     return 1;
+#elif _WIN32
+    return 1;
 #else
     return 0;
 #endif
