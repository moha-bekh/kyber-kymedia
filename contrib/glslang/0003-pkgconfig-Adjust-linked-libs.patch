Subject: [PATCH 3/3] pkgconfig: Adjust linked libs

---
 glslang/glslang.pc.cmake.in | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/glslang/glslang.pc.cmake.in b/glslang/glslang.pc.cmake.in
index 5a21c01..5ea6b66 100644
--- a/glslang/glslang.pc.cmake.in
+++ b/glslang/glslang.pc.cmake.in
@@ -18,7 +18,7 @@
     Description: OpenGL and OpenGL ES shader front end and validator
     Requires:
     Version: @VERSION@
-    Libs: -L${libdir} -lglslang -lOSDependent -lHLSL -lOGLCompiler
+    Libs: -L${libdir} -lglslang -lOSDependent -lglslang-default-resource-limits -lpthread
     Cflags: -I${includedir}
     prefix=@CMAKE_INSTALL_PREFIX@
     exec_prefix=@CMAKE_INSTALL_PREFIX@
